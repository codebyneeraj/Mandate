# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID from the same app's Webhooks section. Leave empty locally; events are then stored as unverified.
PAYPAL_WEBHOOK_ID=

# HMAC key for signing mandates. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MANDATE_SIGNING_SECRET=

# Where PayPal sends the buyer back after approval. Render sets RENDER_EXTERNAL_URL automatically.
PUBLIC_URL=http://localhost:5173
PORT=3000
DATABASE_PATH=mandate.db

# LLM for the shopper agent and AI check (Week 2+). Any OpenAI-compatible endpoint works.
# Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1                           LLM_MODEL=openai/gpt-oss-120b
# Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
